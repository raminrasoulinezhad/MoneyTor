# MoneyTor configuration template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Credentials are per-person, per-institution:
#   MONEYTOR__<PERSON>__<FIELD>=value
# Replace <PERSON> with a short name (RAMIN, ALEX...). Add as many as you like.

# --- Application ---
MONEYTOR_LOG_LEVEL=INFO
MONEYTOR_DISPLAY_CURRENCY=CAD
# Password gate shown on launch. Leave unset/empty to open the app ungated.
# MONEYTOR_APP_PASSWORD=change-me

# --- FX rates ---
# MONEYTOR_FX_PROVIDER=static
# MONEYTOR_FX_API_KEY=

# --- Questrade: App Hub -> Register a personal app -> refresh token ---
# MONEYTOR__PERSON1__QUESTRADE_REFRESH_TOKEN=

# --- Wealthsimple: your login (2FA is prompted in the app) ---
# MONEYTOR__PERSON1__WEALTHSIMPLE_EMAIL=
# MONEYTOR__PERSON1__WEALTHSIMPLE_PASSWORD=

# A person needs a Questrade token, or both Wealthsimple fields, or both sets.
