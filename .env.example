# MoneyTor configuration template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Credentials are per-person, per-institution. The config loader (Phase 2)
# will define the exact schema; the keys below document the intended shape.

# --- Application ---
MONEYTOR_LOG_LEVEL=INFO
MONEYTOR_DISPLAY_CURRENCY=CAD
# Password gate shown on launch. Leave unset/empty to open the app ungated.
# MONEYTOR_APP_PASSWORD=change-me

# --- FX provider (Phase 3) ---
# MONEYTOR_FX_PROVIDER=static
# MONEYTOR_FX_API_KEY=

# --- Questrade (Phase 8) — OAuth refresh token per person ---
# MONEYTOR__PERSON1__QUESTRADE_REFRESH_TOKEN=

# --- Wealthsimple (Phase 8) — credentials per person ---
# MONEYTOR__PERSON1__WEALTHSIMPLE_EMAIL=
# MONEYTOR__PERSON1__WEALTHSIMPLE_PASSWORD=
